{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "SigningKey": "",
    "Issuer": "usermanagementapi",
    "Audience": "usermanagementapi",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "7.00:00:00"
  },
  "Argon2": {
    "MemorySizeKb": 19456,
    "Iterations": 2,
    "DegreeOfParallelism": 1
  },
  "Seed": {
    "AdministratorEmail": "admin@umapi.local",
    "AdministratorPassword": ""
  },
  "RateLimiting": {
    "Auth": { "PermitLimit": 10, "Window": "00:01:00" },
    "Read": { "PermitLimit": 100, "Window": "00:01:00" },
    "Write": { "PermitLimit": 30, "Window": "00:01:00" },
    "DefaultRetryAfterSeconds": 60
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowCredentials": false
  },
  "Outbox": {
    "BatchSize": 20,
    "PollingInterval": "00:00:05",
    "MaxAttempts": 5,
    "BaseBackoff": "00:00:10"
  },
  "AllowedHosts": "*"
}